--[[
    ====================================================================================================
                                 GUASON MONRRERO VX - PERFECTION V2
    ====================================================================================================
    - KEY: vx65 (Con avisos de Correcto/Incorrecto y animaciones)
    - ESP: Cuadro miniatura + Nombres arriba de la cabeza (Color sincronizado)
    - ESTABILIDAD: Cabeza tamaño 5 (Disimulable) para evitar CRASH.
    - MOVIMIENTO: Menú y Key con Tweens fluidos.
    - INSERT: Aviso arriba a la izquierda.
    ====================================================================================================
]]

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local lplayer = Players.LocalPlayer

-- Limpieza
for _, v in pairs(lplayer.PlayerGui:GetChildren()) do
    if v.Name == "GVX_KeySystem" or v.Name == "GVX_UltraFix" then v:Destroy() end
end

local KeyGui = Instance.new("ScreenGui", lplayer.PlayerGui)
KeyGui.Name = "GVX_KeySystem"

local KMain = Instance.new("Frame", KeyGui)
KMain.Size = UDim2.new(0, 420, 0, 280); KMain.Position = UDim2.new(0.5, -210, 1.2, 0)
KMain.BackgroundColor3 = Color3.fromRGB(12, 12, 12); KMain.BorderSizePixel = 0
Instance.new("UICorner", KMain); local KStroke = Instance.new("UIStroke", KMain); KStroke.Color = Color3.fromRGB(255, 0, 150); KStroke.Thickness = 3

TweenService:Create(KMain, TweenInfo.new(0.6, Enum.EasingStyle.Back), {Position = UDim2.new(0.5, -210, 0.5, -140)}):Play()

local KTitle = Instance.new("TextLabel", KMain)
KTitle.Size = UDim2.new(1, 0, 0, 60); KTitle.Text = "👑 <u>GUASON MONRRERO VX</u>"
KTitle.RichText = true; KTitle.TextColor3 = Color3.fromRGB(0, 0, 128); KTitle.TextSize = 24
KTitle.Font = "SourceSansBold"; KTitle.BackgroundTransparency = 1

local KeyInput = Instance.new("TextBox", KMain)
KeyInput.Size = UDim2.new(0, 280, 0, 45); KeyInput.Position = UDim2.new(0.5, -140, 0, 110)
KeyInput.BackgroundColor3 = Color3.fromRGB(25, 25, 25); KeyInput.Text = ""; KeyInput.PlaceholderText = "CONTRASEÑA..."
KeyInput.TextColor3 = Color3.new(1,1,1); KeyInput.Font = "SourceSansBold"; KeyInput.TextSize = 18; Instance.new("UICorner", KeyInput)

local VerifyBtn = Instance.new("TextButton", KMain)
VerifyBtn.Size = UDim2.new(0, 180, 0, 50); VerifyBtn.Position = UDim2.new(0.5, -90, 0, 180)
VerifyBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 128); VerifyBtn.Text = "VERIFICAR"
VerifyBtn.TextColor3 = Color3.new(1,1,1); VerifyBtn.Font = "SourceSansBold"; VerifyBtn.TextSize = 18; Instance.new("UICorner", VerifyBtn)

-- [ FUNCIÓN CARGA DE HACK ] --
local function LoadHack()
    TweenService:Create(KMain, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Position = UDim2.new(0.5, -210, -0.5, 0)}):Play()
    task.wait(0.4); KeyGui:Destroy()
    
    local G_VX = {
        Open = true, Hitbox = false, ESP = false, ColorIdx = 1,
        Colors = {Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 255)},
        Names = {"VERDE", "BLANCO", "ROJO", "CYAN"}
    }

    local ScreenGui = Instance.new("ScreenGui", lplayer.PlayerGui)
    ScreenGui.Name = "GVX_UltraFix"; ScreenGui.ResetOnSpawn = false

    local Hint = Instance.new("TextLabel", ScreenGui)
    Hint.Size = UDim2.new(0, 200, 0, 30); Hint.Position = UDim2.new(0, 10, 0, 10)
    Hint.Text = "ABRIR/CERRAR: [INSERT]"; Hint.TextColor3 = Color3.new(1,1,1); Hint.BackgroundColor3 = Color3.new(0,0,0); Hint.BackgroundTransparency = 0.5; Hint.Font = "SourceSansBold"; Hint.TextSize = 14; Instance.new("UICorner", Hint)

    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = UDim2.new(0, 580, 0, 380); Main.Position = UDim2.new(0.5, -290, 0.5, -190)
    Main.BackgroundColor3 = Color3.fromRGB(12, 12, 12); Main.BorderSizePixel = 0
    Instance.new("UICorner", Main); local Stroke = Instance.new("UIStroke", Main); Stroke.Color = Color3.fromRGB(255, 0, 150); Stroke.Thickness = 2

    local Title = Instance.new("TextLabel", Main)
    Title.Size = UDim2.new(1, 0, 0, 60); Title.Text = "👑 <u>GUASON MONRRERO VX</u>"; Title.RichText = true; Title.TextColor3 = Color3.fromRGB(0, 0, 128); Title.TextSize = 26; Title.Font = "SourceSansBold"; Title.BackgroundTransparency = 1

    local Sidebar = Instance.new("Frame", Main)
    Sidebar.Size = UDim2.new(0, 150, 1, -80); Sidebar.Position = UDim2.new(0, 12, 0, 70); Sidebar.BackgroundColor3 = Color3.fromRGB(20, 20, 20); Instance.new("UICorner", Sidebar)
    Instance.new("UIListLayout", Sidebar).Padding = UDim.new(0, 6)

    local Content = Instance.new("Frame", Main)
    Content.Size = UDim2.new(1, -185, 1, -90); Content.Position = UDim2.new(0, 172, 0, 80); Content.BackgroundTransparency = 1

    local Pages = { Hacks = Instance.new("ScrollingFrame", Content), Visual = Instance.new("ScrollingFrame", Content), Ajustes = Instance.new("ScrollingFrame", Content) }
    for n, p in pairs(Pages) do p.Size = UDim2.new(1, 0, 1, 0); p.Visible = (n == "Hacks"); p.BackgroundTransparency = 1; p.ScrollBarThickness = 0; Instance.new("UIListLayout", p).Padding = UDim.new(0, 10) end

    local function CreateTab(name, icon)
        local btn = Instance.new("TextButton", Sidebar); btn.Size = UDim2.new(1, -10, 0, 45); btn.Text = icon.." "..name; btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30); btn.TextColor3 = Color3.new(1,1,1); btn.Font = "SourceSansBold"; btn.TextSize = 17; Instance.new("UICorner", btn)
        btn.MouseButton1Click:Connect(function() for n, p in pairs(Pages) do p.Visible = (n == name) end end)
    end

    local function CreateToggle(name, parent, key)
        local btn = Instance.new("TextButton", parent); btn.Size = UDim2.new(1, -10, 0, 50); btn.Text = name..": NO"; btn.BackgroundColor3 = Color3.fromRGB(150, 0, 0); btn.TextColor3 = Color3.new(1,1,1); btn.Font = "SourceSansBold"; btn.TextSize = 17; Instance.new("UICorner", btn)
        btn.MouseButton1Click:Connect(function() G_VX[key] = not G_VX[key]; btn.Text = name..": "..(G_VX[key] and "SI" or "NO"); btn.BackgroundColor3 = G_VX[key] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0) end)
    end

    task.spawn(function()
        while task.wait(0.4) do
            local col = G_VX.Colors[G_VX.ColorIdx]
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= lplayer and p.Character then
                    local head = p.Character:FindFirstChild("Head")
                    if head then
                        if G_VX.Hitbox then
                            head.Size = Vector3.new(5, 5, 5); head.Transparency = 0.95; head.CanCollide = false
                            local b = head:FindFirstChild("VX_L") or Instance.new("SelectionBox", head); b.Name = "VX_L"; b.Adornee = head; b.LineThickness = 0.02; b.SurfaceTransparency = 1; b.Color3 = col
                        else
                            head.Size = Vector3.new(1.2, 1, 1); head.Transparency = 0; if head:FindFirstChild("VX_L") then head.VX_L:Destroy() end
                        end
                    end
                    local esp = ScreenGui:FindFirstChild("ESP_"..p.Name)
                    if G_VX.ESP and p.Character:FindFirstChild("HumanoidRootPart") then
                        if not esp then
                            esp = Instance.new("BillboardGui", ScreenGui); esp.Name = "ESP_"..p.Name; esp.Size = UDim2.new(0, 45, 0, 65); esp.AlwaysOnTop = true
                            local f = Instance.new("Frame", esp); f.Size = UDim2.new(1,0,1,0); f.BackgroundTransparency = 1; local s = Instance.new("UIStroke", f); s.Thickness = 1.8; s.Name = "L"
                            local n = Instance.new("TextLabel", esp); n.Name = "NM"; n.Size = UDim2.new(2, 0, 0, 20); n.Position = UDim2.new(-0.5, 0, 0, -32); n.BackgroundTransparency = 1; n.TextColor3 = col; n.TextSize = 14; n.Font = "SourceSansBold"; n.TextStrokeTransparency = 0
                        end
                        esp.Adornee = p.Character.HumanoidRootPart; esp.Enabled = true; esp.Frame.L.Color = col; esp.NM.Text = p.Name; esp.NM.TextColor3 = col
                    elseif esp then esp.Enabled = false end
                end
            end
        end
    end)

    CreateTab("Hacks", "⚔️"); CreateTab("Visual", "👁️"); CreateTab("Ajustes", "⚙️")
    CreateToggle("CABEZA DISIMULABLE", Pages.Hacks, "Hitbox")
    CreateToggle("ESP + NOMBRES", Pages.Visual, "ESP")
    CreateToggle("ANTI-BAN SAFE", Pages.Ajustes, {v=true})

    local ColorBtn = Instance.new("TextButton", Pages.Visual); ColorBtn.Size = UDim2.new(1, -10, 0, 50); ColorBtn.Text = "COLOR: VERDE"; ColorBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40); ColorBtn.TextColor3 = Color3.new(1,1,1); ColorBtn.Font = "SourceSansBold"; Instance.new("UICorner", ColorBtn)
    ColorBtn.MouseButton1Click:Connect(function() G_VX.ColorIdx = (G_VX.ColorIdx % #G_VX.Colors) + 1; ColorBtn.Text = "COLOR: "..G_VX.Names[G_VX.ColorIdx]; ColorBtn.TextColor3 = G_VX.Colors[G_VX.ColorIdx] end)

    UIS.InputBegan:Connect(function(i)
        if i.KeyCode == Enum.KeyCode.Insert then
            G_VX.Open = not G_VX.Open
            local target = G_VX.Open and UDim2.new(0.5, -290, 0.5, -190) or UDim2.new(0.5, -290, 1.3, 0)
            TweenService:Create(Main, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = target}):Play()
        end
    end)
end

-- [ LÓGICA DE LA KEY ] --
VerifyBtn.MouseButton1Click:Connect(function()
    if KeyInput.Text == "vx65" then
        VerifyBtn.Text = "CLAVE CORRECTA"; VerifyBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        task.wait(0.6); LoadHack()
    else
        VerifyBtn.Text = "CLAVE INCORRECTA ❌"; VerifyBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        TweenService:Create(KMain, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, 3, true), {Position = UDim2.new(0.5, -200, 0.5, -140)}):Play()
        task.wait(1); VerifyBtn.Text = "VERIFICAR"; VerifyBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 128)
    end
end)
